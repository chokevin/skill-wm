# skill-wm — environment variables.
# Copy to .env (gitignored) and source it, or export in your shell init.

# OpenAI API key for the LLM-as-WM baseline (later, T1).
OPENAI_API_KEY=

# ---- rune submit knobs ----------------------------------------------------

# Pin the cluster's `pip install skill-wm @ git+...@<ref>` to a specific
# commit so the cluster pod is byte-identical to your laptop. Default is
# 'main' (set in collect_rollouts/config.py); override per submit:
#   SKILL_WM_REPO_REF=$(git rev-parse HEAD) make rune-collect
# export SKILL_WM_REPO_REF=
# export SKILL_WM_REPO_URL=git+https://github.com/chokevin/skill-wm.git

# ---- rune setup (used by bin/setup.sh) ------------------------------------

# Override only if your default `az account` is not the sub that owns
# voice-agent-flex (today the default sub is correct on this machine).
# export SKILL_WM_SUBSCRIPTION=
# export SKILL_WM_CLUSTER_NAME=voice-agent-flex
# export SKILL_WM_CLUSTER_RG=voice-agent-flex-rg
# export SKILL_WM_NS=ray

# If you have a local checkout of aks-ai-runtime, point at applications/rune-py
# to install rune-py without GitHub SSH. Otherwise setup.sh falls back to
# git+ssh://git@github.com/azure-management-and-platforms/aks-ai-runtime.git
# (which works only if your SSH key has access to that org).
# export RUNE_PY_LOCAL=$HOME/dev/aks-ai-runtime/applications/rune-py
